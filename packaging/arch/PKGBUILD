pkgname=arch-notebook-git
pkgver=0.1.0.r1.g8381738
pkgrel=1
pkgdesc='Rust desktop relationship analysis and SQL regression workbench'
arch=('x86_64' 'aarch64')
url='https://github.com/pskeffington/arch_notebook'
license=('MIT')
depends=('gcc-libs' 'glibc' 'libglvnd' 'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxinerama' 'libxkbcommon' 'libxkbcommon-x11' 'libxrandr' 'libxrender' 'shared-mime-info' 'sqlite' 'wayland')
makedepends=('cargo' 'git' 'pkgconf' 'rust')
install=arch-notebook.install
provides=('arch-notebook')
conflicts=('arch-notebook')
source=()
sha256sums=()
if [[ -z "${ARCH_NOTEBOOK_SOURCE_DIR:-}" ]]; then
  source=("$pkgname::git+$url.git#branch=main")
  sha256sums=('SKIP')
fi

pkgver() {
  cd "${ARCH_NOTEBOOK_SOURCE_DIR:-$srcdir/$pkgname}"
  printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "${ARCH_NOTEBOOK_SOURCE_DIR:-$srcdir/$pkgname}"
  cargo fetch --locked
}

build() {
  cd "${ARCH_NOTEBOOK_SOURCE_DIR:-$srcdir/$pkgname}"
  cargo build --release --locked
}

package() {
  cd "${ARCH_NOTEBOOK_SOURCE_DIR:-$srcdir/$pkgname}"
  install -Dm755 target/release/arch-notebook "$pkgdir/usr/bin/arch-notebook"
  install -Dm644 packaging/arch/arch-notebook.desktop "$pkgdir/usr/share/applications/arch-notebook.desktop"
  install -Dm644 assets/icons/arch-notebook.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/arch-notebook.svg"
  install -Dm644 assets/icons/arch-notebook.png "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/arch-notebook.png"
  install -Dm644 packaging/arch/arch-notebook-case.xml "$pkgdir/usr/share/mime/packages/arch-notebook-case.xml"
  install -Dm644 packaging/systemd/arch-notebook-automation.service "$pkgdir/usr/share/arch-notebook/systemd/arch-notebook-automation.service"
  install -Dm644 packaging/systemd/arch-notebook-automation.timer "$pkgdir/usr/share/arch-notebook/systemd/arch-notebook-automation.timer"
  install -Dm755 scripts/install-linux-automation.sh "$pkgdir/usr/bin/arch-notebook-install-automation"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
